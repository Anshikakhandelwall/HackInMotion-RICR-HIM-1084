# Supabase (frontend — Vite only, never used by backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase JWT verification (backend only — never expose to frontend)
# SUPABASE_URL is the base project URL, e.g. https://<ref>.supabase.co
# The issuer and JWKS URL are derived automatically from SUPABASE_URL
# but can be overridden explicitly if needed.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
